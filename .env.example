APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://ozmap:change-me@postgres:5432/ozmap_user_manager?sslmode=disable
OZMAP_BASE_URL=https://sandbox.ozmap.com.br:9994
OZMAP_CLIENT_ID=
OZMAP_CLIENT_SECRET=
OZMAP_AUTHORIZATION=
# Send the password exactly as entered in Excel after removing line breaks and edge whitespace.
# Set to sha256 only if your OZmap tenant specifically requires a SHA-256 password.
OZMAP_PASSWORD_MODE=plain
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
MAX_UPLOAD_SIZE_MB=5
MAX_IMPORT_ROWS=1000
LOG_LEVEL=info
OZMAP_HTTP_TIMEOUT_SECONDS=30
